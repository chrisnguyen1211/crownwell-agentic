# Yasuo Onchain Analyst API Keys
# Real API keys for data fetching

# Bitquery API (for exchange flows and liveliness)
BITQUERY_API_KEY=your_bitquery_api_key_here

# Dune Analytics API (for whale transactions)
DUNE_API_KEY=your_dune_api_key_here

# Etherscan API (for transaction data)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Optional: Moralis API (fallback)
MORALIS_API_KEY=your_moralis_api_key_here

# Configuration
YASUO_CACHE_DURATION=3600
YASUO_RATE_LIMIT=1.0
YASUO_DEBUG_MODE=false
